# ============================================
# Backend Environment Configuration
# ============================================
# Copy file ini menjadi .env dan update values sesuai kebutuhan
# Dokumentasi: https://nodejs.org/en/knowledge/file-system/security/introduction/

# ===== DATABASE =====
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# Contoh Production: postgresql://user:pass@db.example.com:5432/dailyporto_prod
DATABASE_URL=postgresql://postgres:password@localhost:5432/dailyporto

# ===== SERVER CONFIGURATION =====
# Server listening port
PORT=3001

# Application environment
# Values: development, staging, production
NODE_ENV=development

# ===== FRONTEND CONFIGURATION =====
# Frontend URL untuk CORS (allow requests dari URL ini)
# Development: http://localhost:5173
# Production: https://yourportfolio.com
FRONTEND_URL=http://localhost:5173

# ===== SECURITY & AUTHENTICATION =====
# JWT Secret - REQUIRED untuk production!
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JANGAN pernah commit ke git jika sudah di-set!
JWT_SECRET=dev_secret_key_change_in_production

# Session secret
SESSION_SECRET=session_secret_change_in_production

# ===== API RATE LIMITING =====
# Format: requests per window (minutes)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ===== EMAIL CONFIGURATION (Optional) =====
# Untuk notifikasi, password reset, dll
# Gunakan "gmail" untuk development dengan app-specific password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ===== FILE STORAGE CONFIGURATION (Optional) =====
# Untuk cloud image storage bukan base64 di database
# Pilih satu: local, aws_s3, google_cloud, azure

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-bucket-name

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_KEY_FILE=path/to/keyfile.json

# ===== LOGGING =====
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=true

# ===== DATABASE OPTIMIZATION =====
# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===== FEATURE FLAGS =====
# Enable seed endpoint untuk development
ENABLE_SEED_ENDPOINT=true

# Enable request logging middleware
ENABLE_REQUEST_LOG=true
